# Copy to build.env (git-ignored) and edit. Only needed for
# scripts/build_on_iphone.sh and scripts/test_on_iphone.sh.

# ssh destination of a jailbroken iPhone with the Procursus toolchain
# (swift, clang, ldid, zip, python3 from Sileo/Zebra).
PHONE="root@192.0.2.10"

# Private key that logs in to it. Leave empty to use your normal ssh config.
SSH_KEY="$HOME/.ssh/id_ed25519"

# Optional overrides:
# JBROOT="/var/jb"          # jailbreak prefix (rootless default)
# SDK_STAMP="27.1"          # SDK version written into the binary
# OUT="$HOME/Desktop/AppUnboxed.ipa"
